{
  "name": "C++ CMake Ubuntu",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  
  "runArgs": [
    "--cap-add=SYS_PTRACE",
    "--security-opt",
    "seccomp=unconfined"
  ],
  
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y build-essential cmake ninja-build gdb git clang-format clang-tidy",
  
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "twxs.cmake"
      ]
    }
  },
  
  "remoteUser": "vscode"
}
