{
  "name": "C++ CMake Beast",
  "image": "mcr.microsoft.com/devcontainers/cpp:ubuntu-24.04",
  
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "twxs.cmake",
        "ms-vscode.cpptools-extension-pack"
      ]
    }
  },
  
  "runArgs": [
    "--cap-add=SYS_PTRACE",
    "--security-opt",
    "seccomp=unconfined"
  ],
  
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y build-essential gdb git clang-format clang-tidy cmake ninja-build",
  
  "remoteUser": "vscode"
}
